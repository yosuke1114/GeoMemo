            "value" : "通知がまだ設定されていません"
          }
        }
      }
    },
    "GeoMemo can't tell when you reach a saved place. Turn on Location in Settings." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登録した場所に着いたことを検知できません。設定アプリで位置情報をオンにしてください。"
          }
        }
      }
    },
    "Allow location to see your position and get arrival alerts." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地の表示と到着の通知のために、位置情報を許可してください。"
          }
        }
      }
    },
    "Alerts for small areas may be late or missed. Turn on Precise Location in Settings." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
